rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Bucket dedicado ao site Ambiconcept Waste Solutions — imagens de
    // produtos ficam públicas para leitura, escrita só para admin autenticado
    match /produtos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

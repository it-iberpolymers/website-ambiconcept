# Copiar para .env e preencher com os valores do projeto Firebase
# Dashboard: https://console.firebase.google.com/project/<id>/settings/general

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Tradução automática do conteúdo do admin (api/translate.ts). Só no servidor: nunca com prefixo VITE_.
# Na Vercel: Settings → Environment Variables, como Sensitive.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5
